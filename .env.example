# Salin file ini menjadi .env lalu sesuaikan nilainya
ENV=development
PORT=8000

# PostgreSQL — sesuaikan user/password dengan instalasi lokal Anda
DATABASE_URL=postgresql://postgres@localhost:5432/biochemverse

# Redis
REDIS_URL=redis://localhost:6379/0

# Comma-separated, dipakai CORS middleware
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Ganti dengan string acak yang panjang (minimal 32 karakter)
JWT_SECRET=change-me-with-a-long-random-secret

# Password reset email (Resend). FRONTEND_URL dipakai untuk tautan reset.
FRONTEND_URL=http://localhost:5173
RESEND_API_KEY=
EMAIL_FROM=BioChemVerse <noreply@contoh.com>
