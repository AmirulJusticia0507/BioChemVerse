{
  "openapi": "3.1.0",
  "info": {
    "title": "BioChemVerse API",
    "description": "API untuk platform edukasi BioChemVerse: ChemSphere (kimia), ForensiLab (forensik), dan AnatomiMed (anatomi & simulasi pasien).",
    "contact": {
      "name": "BioChemVerse",
      "url": "https://github.com/AmirulJusticia0507/BioChemVerse"
    },
    "license": {
      "name": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/": {
      "get": {
        "tags": [
          "general"
        ],
        "summary": "Info API",
        "description": "Informasi dasar API: nama, versi, dan lokasi dokumentasi.",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RootResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "general"
        ],
        "summary": "Liveness check",
        "description": "Status proses aplikasi (tidak mengecek dependency).",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "general"
        ],
        "summary": "Readiness check",
        "description": "Cek koneksi PostgreSQL dan Redis; 503 bila salah satu tidak siap.",
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "PostgreSQL dan/atau Redis tidak siap",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/modules": {
      "get": {
        "tags": [
          "modules"
        ],
        "summary": "Daftar modul platform",
        "description": "Semua modul utama BioChemVerse beserta fiturnya.",
        "operationId": "list_modules_api_v1_modules_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModuleListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Daftar akun baru",
        "description": "Buat akun baru; password di-hash dengan bcrypt, tidak pernah disimpan polos.",
        "operationId": "register_api_v1_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            }
          },
          "409": {
            "description": "Username atau email sudah terdaftar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login dan dapatkan JWT",
        "description": "Verifikasi kredensial; kembalikan Bearer token berlaku 12 jam.",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Username atau password salah",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Profil pengguna aktif",
        "description": "Butuh header `Authorization: Bearer <token>`.",
        "operationId": "me_api_v1_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            }
          },
          "401": {
            "description": "Token tidak ada, tidak valid, atau kedaluwarsa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorDetail": {
        "properties": {
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status",
            "examples": [
              "degraded"
            ]
          },
          "postgres": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Postgres",
            "examples": [
              "down"
            ]
          },
          "redis": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Redis",
            "examples": [
              "ok"
            ]
          }
        },
        "type": "object",
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/components/schemas/ErrorDetail"
              }
            ],
            "title": "Detail",
            "description": "Keterangan kesalahan; memuat 'degraded' saat readiness gagal"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "'ok' selama proses berjalan",
            "examples": [
              "ok"
            ]
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username",
            "description": "Username",
            "examples": [
              "student1"
            ]
          },
          "password": {
            "type": "string",
            "title": "Password",
            "description": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest"
      },
      "ModuleListResponse": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total",
            "description": "Jumlah modul",
            "examples": [
              3
            ]
          },
          "data": {
            "items": {
              "$ref": "#/components/schemas/ModuleOut"
            },
            "type": "array",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "total",
          "data"
        ],
        "title": "ModuleListResponse"
      },
      "ModuleOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Kode modul",
            "examples": [
              "chemsphere"
            ]
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Nama modul",
            "examples": [
              "ChemSphere Engine"
            ]
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Ringkasan fungsi modul"
          },
          "features": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Features",
            "description": "Daftar fitur utama modul"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "features"
        ],
        "title": "ModuleOut"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "'ready' bila semua dependency siap",
            "examples": [
              "ready"
            ]
          },
          "postgres": {
            "type": "string",
            "title": "Postgres",
            "description": "Status koneksi PostgreSQL",
            "examples": [
              "ok"
            ]
          },
          "redis": {
            "type": "string",
            "title": "Redis",
            "description": "Status koneksi Redis",
            "examples": [
              "ok"
            ]
          },
          "environment": {
            "type": "string",
            "title": "Environment",
            "description": "Environment aktif (ENV)",
            "examples": [
              "development"
            ]
          }
        },
        "type": "object",
        "required": [
          "status",
          "postgres",
          "redis",
          "environment"
        ],
        "title": "ReadinessResponse"
      },
      "RegisterRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64,
            "minLength": 3,
            "title": "Username",
            "description": "Username unik",
            "examples": [
              "student1"
            ]
          },
          "email": {
            "type": "string",
            "maxLength": 255,
            "minLength": 5,
            "title": "Email",
            "description": "Email unik",
            "examples": [
              "siswa@contoh.com"
            ]
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password",
            "description": "Password, minimal 8 karakter"
          }
        },
        "type": "object",
        "required": [
          "username",
          "email",
          "password"
        ],
        "title": "RegisterRequest"
      },
      "RootResponse": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Nama API",
            "examples": [
              "BioChemVerse API"
            ]
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "Versi API",
            "examples": [
              "0.1.0"
            ]
          },
          "docs": {
            "type": "string",
            "title": "Docs",
            "description": "URL Swagger UI",
            "examples": [
              "/docs"
            ]
          },
          "openapi": {
            "type": "string",
            "title": "Openapi",
            "description": "URL spec OpenAPI",
            "examples": [
              "/openapi.json"
            ]
          }
        },
        "type": "object",
        "required": [
          "name",
          "version",
          "docs",
          "openapi"
        ],
        "title": "RootResponse"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token",
            "description": "JWT Bearer token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer",
            "examples": [
              "bearer"
            ]
          },
          "user": {
            "$ref": "#/components/schemas/UserOut",
            "description": "Profil pengguna yang berhasil login"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "user"
        ],
        "title": "TokenResponse"
      },
      "UserOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "UUID pengguna"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "description": "Peran pengguna",
            "examples": [
              "student"
            ]
          },
          "created_at": {
            "type": "string",
            "title": "Created At",
            "description": "Waktu pembuatan akun (ISO-8601)"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username",
          "email",
          "role",
          "created_at"
        ],
        "title": "UserOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "tags": [
    {
      "name": "general",
      "description": "Health check dan informasi dasar API."
    },
    {
      "name": "modules",
      "description": "Daftar modul platform BioChemVerse: ChemSphere, ForensiLab, AnatomiMed."
    },
    {
      "name": "auth",
      "description": "Autentikasi JWT — register, login, dan profil pengguna. Sertakan `Authorization: Bearer <token>`."
    }
  ]
}